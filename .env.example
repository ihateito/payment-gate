# Environment Configuration
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# HTTP Gateway
GATEWAY_HTTP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://payment_user:payment_pass@localhost:5432/payment_gateway?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONns=5

# Redis (Idempotency & Locks)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Kafka / Redpanda (Event Streaming)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events.v1

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=payment-gate
